// WM 2026 Tippspiel – Datenmodell
//
// Provider: PostgreSQL (lokal & Produktion identisch – nötig für Vercel, da
// Serverless kein persistentes Dateisystem hat). DATABASE_URL kommt von einem
// gehosteten Postgres (Vercel Postgres, Neon oder Supabase).
//
// Statt DB-Enums nutzen wir String-Felder mit dokumentierten, in TypeScript
// (src/lib/constants.ts) zentral definierten Werten – bleibt damit portabel.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Nutzer & Profil -------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  // eindeutig, damit Login auch per Anzeigename möglich ist
  displayName  String   @unique
  avatarUrl    String?
  // "USER" | "ADMIN"
  role         String   @default("USER")
  // gesperrte Nutzer können sich nicht mehr einloggen / tippen
  blocked      Boolean  @default(false)
  // Zeitpunkt des abgeschlossenen Onboardings (null = noch nicht gesehen)
  onboardedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  predictions    Prediction[]
  tournamentBets TournamentBet[]
  favorites      Favorite[]

  @@index([role])
}

// --- Teams -----------------------------------------------------------------
model Team {
  id        String   @id @default(cuid())
  // FIFA-/ISO-Code, z. B. GER, BRA, ARG (uppercase)
  code      String   @unique
  name      String
  // ISO-3166-alpha-2 (lowercase) für Flaggen-CDN, z. B. de, br, ar
  flagCode  String?
  group     String?
  createdAt DateTime @default(now())

  // Turnier-Fortschritt (für Turnier-Tipps): tiefste erreichte Runde
  // GROUP | R32 | R16 | QF | SF | FINAL  (null = noch offen)
  reachedPhase String?
  // wurde dieses Team Weltmeister?
  isChampion   Boolean @default(false)

  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")
  tournamentBets TournamentBet[]
  players      Player[]
  scoredGoals  Goal[]
  favoritedBy  Favorite[]
}

// --- Spiele ----------------------------------------------------------------
model Match {
  id         String   @id @default(cuid())
  // ID aus der externen Quelle (für idempotenten Sync)
  externalId String   @unique
  // Fixture-ID von API-Football (für Live-Events/Torschützen), falls gematcht
  apiFixtureId String? @unique
  // Phase: GROUP | R32 | R16 | QF | SF | TP | FINAL
  phase      String
  // nur Gruppenphase, z. B. "A".."L"
  group      String?
  // Anzeige-Label der Runde, z. B. "Gruppe A", "Achtelfinale"
  roundLabel String?
  kickoff    DateTime
  venue      String?
  city       String?

  homeTeamId String?
  awayTeamId String?
  homeTeam   Team?   @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam   Team?   @relation("AwayTeam", fields: [awayTeamId], references: [id])

  // Platzhalter-Namen, solange Teams (K.o.) noch nicht feststehen
  homePlaceholder String?
  awayPlaceholder String?

  // "scheduled" | "live" | "finished"
  status     String   @default("scheduled")
  homeGoals  Int?
  awayGoals  Int?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  predictions Prediction[]
  goals       Goal[]

  @@index([kickoff])
  @@index([phase])
  @@index([status])
}

// --- Tipps -----------------------------------------------------------------
model Prediction {
  id         String   @id @default(cuid())
  userId     String
  matchId    String
  // "HOME_WIN" | "DRAW" | "AWAY_WIN"
  prediction String
  // Joker: verdoppelt die Punkte dieses Tipps (max. 1 pro Phase)
  isJoker    Boolean  @default(false)
  // vergebene Punkte (null = noch nicht ausgewertet)
  points     Int?
  // true sobald das Spiel ausgewertet wurde
  scored     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  // Ein Nutzer darf pro Spiel nur genau EINEN Tipp haben.
  @@unique([userId, matchId])
  @@index([matchId])
}

// --- Turnier-Tipps (Outright / Bonuspunkte) --------------------------------
model TournamentBet {
  id          String   @id @default(cuid())
  userId      String
  // Frage-Schlüssel, z. B. "champion" | "final" | "semi" | "r16" | "r32" | "topscorer"
  questionKey String
  // Team-Tipp ODER Spieler-Tipp (je nach Frage); genau einer ist gesetzt.
  teamId      String?
  playerId    String?
  // vergebene Bonuspunkte (null = noch nicht ausgewertet)
  points      Int?
  scored      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player? @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // ein Tipp pro Nutzer und Frage
  @@unique([userId, questionKey])
  @@index([questionKey])
}

// --- Spieler & Tore (Torschützen-Statistik, via API-Football) ---------------
model Player {
  id          String   @id @default(cuid())
  // Spieler-ID von API-Football (für idempotenten Sync)
  externalId  String   @unique
  name        String
  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  goals       Int      @default(0)
  assists     Int      @default(0)
  // ist aktueller Torschützenkönig (höchste Toranzahl)
  isTopScorer Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tournamentBets TournamentBet[]
  goalEvents     Goal[]

  @@index([goals])
}

model Goal {
  id         String   @id @default(cuid())
  // eindeutige Referenz aus der Quelle (z. B. "fixtureId-elapsed-player")
  externalId String?  @unique
  matchId    String
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId   String?
  player     Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  playerName String
  teamId     String?
  team       Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  minute     Int?
  // "normal" | "penalty" | "own"
  type       String   @default("normal")
  createdAt  DateTime @default(now())

  @@index([matchId])
}

// --- Lieblingsländer (Favoriten) -------------------------------------------
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
}

// --- App-Einstellungen (Key/Value) ----------------------------------------
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
