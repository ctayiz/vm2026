# ------------------------------------------------------------------
# Datenbank: PostgreSQL (lokal & Produktion gleich)
# Gehostetes Postgres nutzen – z. B.:
#   - Vercel Postgres (Storage-Tab im Vercel-Projekt) -> Variable heißt dort POSTGRES_PRISMA_URL
#   - Neon (neon.tech, kostenlos)        -> ?sslmode=require anhängen
#   - Supabase (supabase.com)            -> Connection Pooling URL verwenden
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ------------------------------------------------------------------
# Auth
# Beliebiges, langes Secret. Erzeugen z. B. mit:  openssl rand -base64 32
AUTH_SECRET="bitte-aendern-langes-zufaelliges-secret-mind-32-zeichen"

# ------------------------------------------------------------------
# Admin-Bootstrap: dieser User wird beim Seed/Registrierung automatisch Admin
ADMIN_EMAIL="swisshash.hosting@gmail.com"

# Optionaler Einladungscode (leer lassen = Registrierung offen)
INVITE_CODE=""

# Schützt den Cron-Sync-Endpunkt /api/cron/sync.
# Auf Vercel setzt der Cron automatisch "Authorization: Bearer <CRON_SECRET>".
# Leer lassen = Endpunkt offen (nur lokal/Dev empfohlen). Erzeugen: openssl rand -hex 16
CRON_SECRET=""

# ------------------------------------------------------------------
# Spielplan-Datenquelle
# EMPFOHLEN (kostenlos, WM im Free-Tier): football-data.org
# Token: https://www.football-data.org/client/register
FOOTBALLDATA_TOKEN=""
FOOTBALLDATA_COMPETITION="WC"

# Alternativ: API-Football / API-Sports — Saison 2026 nur im BEZAHLPLAN (Free = 2022–2024)
APIFOOTBALL_KEY=""
# WM 2026 = league 1, season 2026 (nur anpassen, falls nötig)
APIFOOTBALL_LEAGUE="1"
APIFOOTBALL_SEASON="2026"
# Nur falls API-Football über RapidAPI genutzt wird (sonst leer lassen):
APIFOOTBALL_HOST=""
# Fallback (Standard): OpenFootball JSON
WORLDCUP_JSON_URL="https://raw.githubusercontent.com/openfootball/worldcup.json/master/2026/worldcup.json"
